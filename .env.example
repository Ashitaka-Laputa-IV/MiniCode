# Copy this file to .env and fill in the real values.
# .env is ignored by git; never commit real keys.

# Required for the default model.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Optional: OpenCode Go provider. Use models as `opencode-go:<model-id>`.
# OPENCODE_GO_API_KEY=oc_sk-your-key
# OPENCODE_GO_SESSION=stable-session-id

# Optional: override the default model.
# MINICODE_MODEL=deepseek:deepseek-flash
